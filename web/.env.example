# Copy to .env.local and adjust as needed.

# Use the built-in static mock API. Set to "false" to talk to the GopherAgent
# backend instead.
VITE_USE_MOCK=false

# Backend address. When set, the console sends every request to this absolute
# URL (no dev proxy required) and the value is baked into production builds.
# Start the backend with `go run main.go` (defaults to :9899).
VITE_BACKEND_URL=http://localhost:9899
